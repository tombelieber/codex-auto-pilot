{
  "description": "Local-only Auto Pilot run history collection. No data is uploaded.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/skills/auto-pilot/scripts/collect_history.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\auto-pilot\\scripts\\collect_history.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/skills/auto-pilot/scripts/collect_history.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\auto-pilot\\scripts\\collect_history.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/skills/auto-pilot/scripts/collect_history.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\auto-pilot\\scripts\\collect_history.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/skills/auto-pilot/scripts/collect_history.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\skills\\auto-pilot\\scripts\\collect_history.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
